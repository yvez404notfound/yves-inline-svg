{
	"name": "yvez-inline-svg",
	"version": "1.0.1",
	"description": "Small React/Next.js component for safely inlining SVG markup and URL-loaded SVGs.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yvez404notfound/yvez-inline-svg.git"
	},
	"keywords": [
		"inline-svg",
		"nextjs",
		"react",
		"sanitize",
		"svg"
	],
	"license": "MIT",
	"author": "Yves",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"imports": {
		"#sanitize-runtime": {
			"browser": "./dist/sanitize.browser.js",
			"node": "./dist/sanitize.node.js",
			"default": "./dist/sanitize.browser.js"
		}
	},
	"files": [
		"dist",
		"scripts",
		"README.md",
		"CONTRIBUTING.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "rm -rf dist .test-dist && npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"lint": "tsc --noEmit -p tsconfig.test.json",
		"bundle:size": "npm run build && node scripts/check-browser-bundle.mjs",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"dependencies": {
		"dompurify": "^3.4.13",
		"jsdom": "^26.1.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.1.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.2.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"esbuild": "^0.28.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18"
	}
}
